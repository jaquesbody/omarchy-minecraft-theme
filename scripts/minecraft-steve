#!/bin/bash
# Minecraft Steve companion toggle — bound to SUPER+SHIFT+S.
set -euo pipefail

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
PLUGIN_ID="io.github.jaquesbody.minecraft-steve"
STATE_DIR="$HOME/.local/state/minecraft-theme"
mkdir -p "$STATE_DIR"
FLAG="$STATE_DIR/steve-active"

case "${1:-toggle}" in
  show)
    omarchy-shell shell summon "$PLUGIN_ID" '{}'
    touch "$FLAG"
    [ -x "$HOME/.local/bin/minecraft-sound" ] && minecraft-sound open || true
    ;;
  hide)
    omarchy-shell shell hide "$PLUGIN_ID"
    rm -f "$FLAG"
    [ -x "$HOME/.local/bin/minecraft-sound" ] && minecraft-sound close || true
    ;;
  toggle)
    # Drive shell state from our FLAG (not shell toggle) so a missed hide
    # cannot permanently invert the keybind.
    if [ -f "$FLAG" ]; then
      omarchy-shell shell hide "$PLUGIN_ID"
      rm -f "$FLAG"
      [ -x "$HOME/.local/bin/minecraft-sound" ] && minecraft-sound close || true
    else
      omarchy-shell shell summon "$PLUGIN_ID" '{}'
      touch "$FLAG"
      [ -x "$HOME/.local/bin/minecraft-sound" ] && minecraft-sound open || true
    fi
    ;;
  status)
    if [ -f "$FLAG" ]; then echo "on"; else echo "off"; fi
    ;;
  *)
    echo "Usage: minecraft-steve [toggle|show|hide|status]"
    exit 1
    ;;
esac
